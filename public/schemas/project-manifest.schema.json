{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ssar-group/.github/blob/main/pub/sch/project-manifest.schema.json",

  "title": "Project Manifest",
  "description": "Schema for SSAR project manifest files.",
  "type": "object",

  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "The manifest schema version."
    },

    "information": {
      "type": "object"
    },

    "internal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Project manifest ID."
        },

        "project": {
          "type": "string",
          "description": "Project ID."
        }
      },

      "required": ["id", "project"],

      "additionalProperties": false
    }
  },

  "required": ["version", "information", "internal"],

  "additionalProperties": false,

  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v1"
      }
    },

    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v2"
      }
    },

    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v3"
      }
    },

    {
      "if": {
        "properties": {
          "version": {
            "const": 4
          }
        }
      },
      "then": {
        "$ref": "#/$defs/v4"
      }
    }
  ],

  "$defs": {
    "v1": {
      "type": "object"
    },

    "v2": {
      "type": "object",

      "properties": {
        "v2.api_ref": {
          "type": "array",
          "default": ["api/v2/manifest/reference.json"]
        }
      },

      "required": ["v2.api_ref"]
    },

    "v3": {
      "type": "object"
    },

    "v4": {
      "type": "object"
    }
  }
}
