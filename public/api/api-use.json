{
  "$schema": "../schemas/api-reference.schema.json",

  "references": {
    "default-api": {
      "name": "SSAR API",

      "versions": {
        "v1": {
          "version": "1.89.5-prod",
          "endpoint": "https://api.ssar-group.com/v1/",
          "status": "legacy",

          "features": ["legacy", "old-tool-api"],
          "requireToken": true
        },
        "v2": {
          "version": "2.134.1-prod",
          "endpoint": "https://api.ssar-group.com/v2/",
          "status": "stable",

          "features": ["rest", "api-key", "server-process"]
        },
        "v3": {
          "version": "3.57.1-prod",
          "endpoint": "https://api.ssar-group.com/v3/",
          "status": "stable",

          "features": [
            "rest",
            "authentication",
            "pagination",
            "search",
            "downloads",
            "uploads",
            "scripts",
            "cross-request",
            "mcp",
            "llms",
            "server-process"
          ]
        }
      }
    },
    "developper-api": {
      "name": "Developper API",

      "versions": {
        "v1": {
          "version": "1.22.1-prod",
          "endpoint": "https://api.ssar-group.com/dev/v1/",
          "status": "beta",
          "requireToken": true
        },
        "c2": {
          "version": "C2.1.0-prod",
          "endpoint": "https://api.ssar-group.com/dev/c2/",
          "status": "development",
          "requireToken": true
        }
      }
    }
  }
}
